[Unit]
Description=Restricted SFTP intake for network-scoped User Manager imports
After=network.target

[Service]
ExecStartPre=/usr/sbin/sshd -t -f /etc/ssh/sshd_config_sam_um_import
ExecStart=/usr/sbin/sshd -D -f /etc/ssh/sshd_config_sam_um_import -E /var/log/sam-um-import-sftp.log
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
User=root
Group=root
RuntimeDirectory=sshd-sam-um-import
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/run /var/log

[Install]
WantedBy=multi-user.target
